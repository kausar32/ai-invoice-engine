# 1. Base image: Official lightweight Node.js 20 Linux environment
FROM node:20-slim

# 2. Install Linux system-level libraries needed by Headless Chromium
RUN apt-get update && apt-get install -y \
    wget \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# 3. Create app workspace directory inside the container
WORKDIR /usr/src/app

# 4. Copy package manifests first (optimizes Docker build cache)
COPY package*.json ./

# 5. Install Node.js dependencies inside the container
RUN npm install

# 6. Copy the rest of the application files
COPY . .

# 7. Expose the port the app listens on
EXPOSE 3000

# 8. Define the container startup command
CMD ["npm", "start"]